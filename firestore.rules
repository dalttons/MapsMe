rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Colección principal
    match /negocios/{docId} {
      allow read, write: if request.auth != null;
    }

    // Denegar todo lo demás explícitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}